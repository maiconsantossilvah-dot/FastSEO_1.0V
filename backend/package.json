{
  "name": "fastseo-users-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude dist/**",
    "firebase:login": "firebase login",
    "deploy:rules": "firebase deploy --config ../firebase.json --project fastseo-6a61b --only firestore:rules"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.2.1",
    "firebase-admin": "14.3.0",
    "helmet": "8.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "firebase-tools": "15.28.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
