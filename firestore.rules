rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUser().status == 'active';
    }

    function hasRole(roles) {
      return isActive() && currentUser().role in roles;
    }

    function canManagePrompts() {
      return hasRole(['owner', 'admin']);
    }

    // Perfis e auditoria são gravados exclusivamente pelo backend (Admin SDK).
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || hasRole(['owner', 'admin']));
      allow list: if hasRole(['owner', 'admin']);
      allow create, update, delete: if false;

      // O histórico pertence ao usuário que o gerou. Mantê-lo como subcoleção
      // evita consultas globais e impede que um colaborador leia ou apague as
      // fichas de outro membro da equipe.
      match /history/{historyId} {
        allow read: if isActive() && request.auth.uid == uid;
        allow create, update, delete: if request.auth.uid == uid
          && hasRole(['owner', 'admin', 'collaborator']);
      }
    }

    match /auditLogs/{logId} {
      allow read: if hasRole(['owner', 'admin']);
      allow create, update, delete: if false;
    }

    // Telemetria é escrita e consultada somente pelo backend. Isso bloqueia
    // escrita direta e leitura cruzada; no modelo BYOK os números continuam
    // informativos, pois a chamada original ao provedor ocorre no navegador.
    match /usageEvents/{eventId} {
      allow read, create, update, delete: if false;
    }

    match /usageDaily/{aggregateId} {
      allow read, create, update, delete: if false;
    }

    // Coleções legadas permanecem somente para leitura durante a migração.
    // Toda alteração de categorias novas deve passar pelo backend, que aplica
    // a permissão manageCategoryCatalog (owner/admin) e registra auditoria.
    match /categories/{document=**} {
      allow read: if isActive();
      allow write: if false;
    }

    match /subcategories/{document=**} {
      allow read: if isActive();
      allow write: if false;
    }

    // Histórico global legado: preservado para eventual migração administrativa,
    // mas nenhum cliente pode continuar gravando ou apagando documentos aqui.
    match /history/{document=**} {
      allow read: if hasRole(['owner', 'admin']);
      allow write: if false;
    }

    // Colaboradores precisam ler os prompts para executar o pipeline, mas só
    // owner/admin podem alterar as instruções dos agentes.
    match /prompts/{document=**} {
      allow read: if isActive();
      allow write: if canManagePrompts();
    }

    // Coleção legada mantida apenas para consulta administrativa durante a transição.
    match /usuarios_autorizados/{document=**} {
      allow read: if hasRole(['owner', 'admin']);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
